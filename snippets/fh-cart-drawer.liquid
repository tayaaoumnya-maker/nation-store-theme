{% comment %}
  Snippet: Cart Drawer avec Cross-sell
  Panneau latéral qui s'ouvre à l'ajout au panier avec suggestions cross-sell
{% endcomment %}

<!-- Overlay -->
<div class="fh-drawer-overlay" id="fh-drawer-overlay"></div>

<!-- Drawer -->
<div class="fh-cart-drawer" id="fh-cart-drawer" aria-label="Panier">
  <div class="fh-drawer-header">
    <div class="fh-drawer-title">Ton vestiaire <span class="fh-drawer-count" id="fh-drawer-count">({{ cart.item_count }})</span></div>
    <button class="fh-drawer-close" id="fh-drawer-close" aria-label="Fermer">&times;</button>
  </div>

  <div class="fh-drawer-body" id="fh-drawer-body">
    {% if cart.item_count > 0 %}
      <div class="fh-drawer-items" id="fh-drawer-items">
        {% for item in cart.items %}
          <div class="fh-drawer-item" data-line="{{ forloop.index }}">
            <div class="fh-drawer-item-img">
              {% if item.image %}
                {{ item.image | image_url: width: 120 | image_tag: loading: 'lazy' }}
              {% else %}
                <span class="fh-drawer-item-placeholder">⚽</span>
              {% endif %}
            </div>
            <div class="fh-drawer-item-info">
              <a href="{{ item.url }}" class="fh-drawer-item-title">{{ item.product.title }}</a>
              <div class="fh-drawer-item-variant">{{ item.variant.title }}</div>
              <div class="fh-drawer-item-price">{{ item.final_price | money }}</div>
              <div class="fh-drawer-item-qty">
                <button class="fh-qty-btn" data-action="minus" data-line="{{ forloop.index }}">-</button>
                <span class="fh-qty-val">{{ item.quantity }}</span>
                <button class="fh-qty-btn" data-action="plus" data-line="{{ forloop.index }}">+</button>
              </div>
            </div>
            <button class="fh-drawer-item-remove" data-line="{{ forloop.index }}" aria-label="Supprimer">&times;</button>
          </div>
        {% endfor %}
      </div>
    {% else %}
      <div class="fh-drawer-empty" id="fh-drawer-empty">
        <span class="fh-drawer-empty-icon">⚽</span>
        <p>Ton vestiaire est vide.<br>Il est temps de choisir tes couleurs.</p>
      </div>
    {% endif %}

    <!-- Cross-sell -->
    <div class="fh-drawer-crosssell" id="fh-drawer-crosssell">
      <div class="fh-drawer-crosssell-title">Complète ta collection</div>
      <div class="fh-drawer-crosssell-grid" id="fh-drawer-crosssell-grid">
        {%- comment -%} Populated via JS after add-to-cart {%- endcomment -%}
      </div>
    </div>
  </div>

  <!-- Footer -->
  <div class="fh-drawer-footer" id="fh-drawer-footer">
    <div class="fh-drawer-free-shipping" id="fh-drawer-free-shipping">
      {%- assign free_shipping_threshold = 4900 -%}
      {%- assign remaining = free_shipping_threshold | minus: cart.total_price -%}
      {% if remaining > 0 %}
        <div class="fh-shipping-bar">
          <div class="fh-shipping-fill" style="width:{{ cart.total_price | times: 100 | divided_by: free_shipping_threshold | at_most: 100 }}%"></div>
        </div>
        <div class="fh-shipping-text">Plus que <strong>{{ remaining | money }}</strong> pour la livraison offerte !</div>
      {% else %}
        <div class="fh-shipping-bar"><div class="fh-shipping-fill" style="width:100%"></div></div>
        <div class="fh-shipping-text fh-shipping-free">🎉 Livraison offerte !</div>
      {% endif %}
    </div>
    <div class="fh-drawer-total">
      <span>Total</span>
      <span id="fh-drawer-total-price">{{ cart.total_price | money }}</span>
    </div>
    <a href="/checkout" class="fh-drawer-checkout" id="fh-drawer-checkout">Valider ma commande &rarr;</a>
  </div>
</div>

<style>
  .fh-drawer-overlay{position:fixed;inset:0;background:rgba(0,0,0,0.5);z-index:999;opacity:0;visibility:hidden;transition:all .3s;backdrop-filter:blur(4px)}
  .fh-drawer-overlay.open{opacity:1;visibility:visible}
  .fh-cart-drawer{position:fixed;top:0;right:-420px;width:400px;max-width:90vw;height:100vh;background:#fff;z-index:1000;display:flex;flex-direction:column;transition:right .35s cubic-bezier(.16,1,.3,1);box-shadow:-8px 0 40px rgba(0,0,0,0.1)}
  .fh-cart-drawer.open{right:0}
  .fh-drawer-header{display:flex;align-items:center;justify-content:space-between;padding:20px 24px;border-bottom:1px solid #e0e0dc}
  .fh-drawer-title{font-family:'Bebas Neue',Impact,sans-serif;font-size:24px;letter-spacing:2px;text-transform:uppercase;color:#0d1b2a}
  .fh-drawer-count{color:#777;font-size:18px}
  .fh-drawer-close{background:none;border:none;font-size:28px;cursor:pointer;color:#777;transition:color .3s;padding:0;line-height:1}
  .fh-drawer-close:hover{color:#0d1b2a}
  .fh-drawer-body{flex:1;overflow-y:auto;padding:20px 24px}
  .fh-drawer-items{display:flex;flex-direction:column;gap:16px}
  .fh-drawer-item{display:flex;gap:14px;padding-bottom:16px;border-bottom:1px solid #f0f0ee;position:relative}
  .fh-drawer-item-img{width:72px;height:90px;border-radius:10px;overflow:hidden;background:#f5f5f3;display:flex;align-items:center;justify-content:center;flex-shrink:0}
  .fh-drawer-item-img img{width:100%;height:100%;object-fit:cover}
  .fh-drawer-item-placeholder{font-size:28px}
  .fh-drawer-item-info{flex:1;min-width:0}
  .fh-drawer-item-title{font-size:13px;font-weight:600;color:#0d1b2a;text-decoration:none;font-family:'Inter',sans-serif;display:block;line-height:1.3}
  .fh-drawer-item-title:hover{color:#d4a843}
  .fh-drawer-item-variant{font-size:11px;color:#777;margin-top:2px;font-family:'Inter',sans-serif}
  .fh-drawer-item-price{font-size:14px;font-weight:700;color:#0d1b2a;margin-top:6px;font-family:'Inter',sans-serif}
  .fh-drawer-item-qty{display:flex;align-items:center;gap:0;margin-top:8px;border:1px solid #e0e0dc;border-radius:6px;width:fit-content}
  .fh-qty-btn{width:28px;height:28px;background:none;border:none;cursor:pointer;font-size:14px;color:#444;display:flex;align-items:center;justify-content:center;transition:background .2s}
  .fh-qty-btn:hover{background:#f5f5f3}
  .fh-qty-val{min-width:24px;text-align:center;font-size:13px;font-weight:600;font-family:'Inter',sans-serif}
  .fh-drawer-item-remove{position:absolute;top:0;right:0;background:none;border:none;font-size:18px;color:#bbb;cursor:pointer;padding:0;line-height:1}
  .fh-drawer-item-remove:hover{color:#c00}
  .fh-drawer-empty{text-align:center;padding:48px 0}
  .fh-drawer-empty-icon{font-size:48px;display:block;margin-bottom:12px}
  .fh-drawer-empty p{font-size:14px;color:#777;line-height:1.6;font-family:'Inter',sans-serif}
  .fh-drawer-crosssell{margin-top:24px;padding-top:20px;border-top:1px solid #e0e0dc}
  .fh-drawer-crosssell-title{font-family:'Bebas Neue',Impact,sans-serif;font-size:18px;letter-spacing:1px;text-transform:uppercase;color:#0d1b2a;margin-bottom:14px}
  .fh-drawer-crosssell-grid{display:flex;gap:10px;overflow-x:auto;padding-bottom:8px;-webkit-overflow-scrolling:touch}
  .fh-drawer-crosssell-grid::-webkit-scrollbar{height:4px}
  .fh-drawer-crosssell-grid::-webkit-scrollbar-thumb{background:#e0e0dc;border-radius:4px}
  .fh-xsell-card{min-width:140px;border-radius:12px;overflow:hidden;position:relative;cursor:pointer;text-decoration:none;display:block;flex-shrink:0}
  .fh-xsell-card-bg{height:100px;display:flex;align-items:center;justify-content:center;position:relative}
  .fh-xsell-card-bg::after{content:'';position:absolute;inset:0;background:linear-gradient(180deg,transparent 30%,rgba(0,0,0,0.7) 100%)}
  .fh-xsell-emoji{font-size:36px;position:relative;z-index:1}
  .fh-xsell-card-bg img{width:100%;height:100%;object-fit:cover}
  .fh-xsell-info{position:absolute;bottom:0;left:0;right:0;padding:10px;z-index:2}
  .fh-xsell-country{font-family:'Bebas Neue',Impact,sans-serif;font-size:14px;letter-spacing:1px;text-transform:uppercase;color:#fff}
  .fh-xsell-price{font-size:11px;color:#d4a843;font-weight:600;font-family:'Inter',sans-serif}
  .fh-drawer-footer{padding:16px 24px 24px;border-top:1px solid #e0e0dc;background:#fff}
  .fh-shipping-bar{height:4px;background:#e0e0dc;border-radius:4px;margin-bottom:8px;overflow:hidden}
  .fh-shipping-fill{height:100%;background:linear-gradient(90deg,#d4a843,#f0d78c);border-radius:4px;transition:width .4s}
  .fh-shipping-text{font-size:12px;color:#777;text-align:center;margin-bottom:12px;font-family:'Inter',sans-serif}
  .fh-shipping-free{color:#d4a843;font-weight:600}
  .fh-drawer-total{display:flex;justify-content:space-between;align-items:center;font-family:'Inter',sans-serif;font-size:16px;font-weight:700;color:#0d1b2a;margin-bottom:14px}
  .fh-drawer-checkout{display:block;width:100%;padding:16px;background:linear-gradient(135deg,#0d1b2a,#162d4a);color:#fff;text-align:center;border:none;border-radius:8px;font-size:14px;font-weight:800;text-transform:uppercase;letter-spacing:2px;font-family:'Inter',sans-serif;text-decoration:none;transition:all .3s;box-shadow:0 8px 30px rgba(13,27,42,0.25)}
  .fh-drawer-checkout:hover{transform:translateY(-2px);box-shadow:0 16px 48px rgba(13,27,42,0.4)}
  @media(max-width:500px){.fh-cart-drawer{width:100%;max-width:100%;right:-100%}}
</style>

<script>
(function(){
  /* Cross-sell product data (all 5 jerseys) */
  var allProducts = [
    {%- for product in collections.all.products limit: 20 -%}
      {%- if product.type == 'T-shirt' and product.vendor == 'Nation Varsity' -%}
        {
          id: {{ product.variants.first.id }},
          handle: {{ product.handle | json }},
          title: {{ product.title | json }},
          url: {{ product.url | json }},
          price: {{ product.price | money | json }},
          image: {{ product.featured_image | image_url: width: 300 | json }},
          country: {{ product.title | remove: 'T-shirt Supporter ' | remove: ' Vintage' | split: ' — ' | last | json }}
        },
      {%- endif -%}
    {%- endfor -%}
  ];

  /* Country gradients */
  var gradients = {
    'Atlas Lions': 'linear-gradient(180deg,#c1272d,#5a0f14)',
    'Fennecs': 'linear-gradient(180deg,#006233,#002614)',
    'Les Elephants': 'linear-gradient(180deg,#FF8200,#7a3e00)',
    'Cocorico': 'linear-gradient(180deg,#0055A4,#002952)',
    'Selecao': 'linear-gradient(180deg,#009C3B,#005a22)'
  };

  var emojis = {
    'Atlas Lions': '🇲🇦',
    'Fennecs': '🇩🇿',
    'Les Elephants': '🇨🇮',
    'Cocorico': '🇫🇷',
    'Selecao': '🇧🇷'
  };

  var drawer = document.getElementById('fh-cart-drawer');
  var overlay = document.getElementById('fh-drawer-overlay');
  var closeBtn = document.getElementById('fh-drawer-close');
  var crosssellGrid = document.getElementById('fh-drawer-crosssell-grid');

  function openDrawer(){ drawer.classList.add('open'); overlay.classList.add('open'); document.body.style.overflow='hidden'; }
  function closeDrawer(){ drawer.classList.remove('open'); overlay.classList.remove('open'); document.body.style.overflow=''; }

  closeBtn.addEventListener('click', closeDrawer);
  overlay.addEventListener('click', closeDrawer);
  document.addEventListener('keydown', function(e){ if(e.key==='Escape') closeDrawer(); });

  /* Cart icon in header opens drawer */
  document.querySelectorAll('.fh-cart-badge').forEach(function(el){
    el.addEventListener('click', function(e){ e.preventDefault(); openDrawer(); });
  });

  /* Render cross-sell cards excluding current cart products */
  function renderCrossSell(cartItems){
    if(!crosssellGrid) return;
    var cartHandles = (cartItems||[]).map(function(i){ return i.handle; });
    var suggestions = allProducts.filter(function(p){ return cartHandles.indexOf(p.handle) === -1; });
    if(suggestions.length === 0){ document.getElementById('fh-drawer-crosssell').style.display='none'; return; }
    document.getElementById('fh-drawer-crosssell').style.display='block';
    crosssellGrid.innerHTML = suggestions.map(function(p){
      var grad = gradients[p.country] || 'linear-gradient(180deg,#444,#222)';
      var emoji = emojis[p.country] || '⚽';
      return '<a href="'+p.url+'" class="fh-xsell-card"><div class="fh-xsell-card-bg" style="background:'+grad+'">'
        +(p.image ? '<img src="'+p.image+'" alt="'+p.country+'" loading="lazy">' : '<span class="fh-xsell-emoji">'+emoji+'</span>')
        +'<div class="fh-xsell-info"><div class="fh-xsell-country">'+p.country+'</div><div class="fh-xsell-price">'+p.price+'</div></div></div></a>';
    }).join('');
  }

  /* Re-render drawer body from cart JSON */
  function refreshDrawer(){
    fetch('/cart.js').then(function(r){return r.json()}).then(function(cart){
      /* Update count */
      document.querySelectorAll('.fh-cart-count').forEach(function(el){ el.textContent = cart.item_count; });
      document.getElementById('fh-drawer-count').textContent = '(' + cart.item_count + ')';
      document.getElementById('fh-drawer-total-price').textContent = formatMoney(cart.total_price);

      /* Update items */
      var itemsEl = document.getElementById('fh-drawer-items');
      var emptyEl = document.getElementById('fh-drawer-empty');
      if(cart.item_count === 0){
        if(itemsEl) itemsEl.innerHTML = '';
        if(emptyEl) emptyEl.style.display = 'block';
      } else {
        if(emptyEl) emptyEl.style.display = 'none';
        if(!itemsEl){
          var body = document.getElementById('fh-drawer-body');
          var div = document.createElement('div'); div.className='fh-drawer-items'; div.id='fh-drawer-items';
          body.insertBefore(div, body.firstChild);
          itemsEl = div;
        }
        itemsEl.innerHTML = cart.items.map(function(item, idx){
          var img = item.image ? '<img src="'+getSizedImageUrl(item.image, '120x')+'" loading="lazy">' : '<span class="fh-drawer-item-placeholder">⚽</span>';
          return '<div class="fh-drawer-item" data-line="'+(idx+1)+'">'
            +'<div class="fh-drawer-item-img">'+img+'</div>'
            +'<div class="fh-drawer-item-info">'
            +'<a href="'+item.url+'" class="fh-drawer-item-title">'+item.product_title+'</a>'
            +'<div class="fh-drawer-item-variant">'+item.variant_title+'</div>'
            +'<div class="fh-drawer-item-price">'+formatMoney(item.final_price)+'</div>'
            +'<div class="fh-drawer-item-qty">'
            +'<button class="fh-qty-btn" data-action="minus" data-line="'+(idx+1)+'">-</button>'
            +'<span class="fh-qty-val">'+item.quantity+'</span>'
            +'<button class="fh-qty-btn" data-action="plus" data-line="'+(idx+1)+'">+</button>'
            +'</div></div>'
            +'<button class="fh-drawer-item-remove" data-line="'+(idx+1)+'" aria-label="Supprimer">&times;</button>'
            +'</div>';
        }).join('');
        bindItemActions();
      }

      /* Free shipping bar */
      var threshold = 4900;
      var remaining = threshold - cart.total_price;
      var pct = Math.min(100, cart.total_price * 100 / threshold);
      var fsEl = document.getElementById('fh-drawer-free-shipping');
      if(fsEl){
        if(remaining > 0){
          fsEl.innerHTML = '<div class="fh-shipping-bar"><div class="fh-shipping-fill" style="width:'+pct+'%"></div></div><div class="fh-shipping-text">Plus que <strong>'+formatMoney(remaining)+'</strong> pour la livraison offerte !</div>';
        } else {
          fsEl.innerHTML = '<div class="fh-shipping-bar"><div class="fh-shipping-fill" style="width:100%"></div></div><div class="fh-shipping-text fh-shipping-free">🎉 Livraison offerte !</div>';
        }
      }

      /* Cross-sell */
      renderCrossSell(cart.items);

      /* Show/hide footer */
      document.getElementById('fh-drawer-footer').style.display = cart.item_count > 0 ? 'block' : 'none';
    });
  }

  function formatMoney(cents){
    return (cents / 100).toFixed(2).replace('.', ',') + '€';
  }

  function getSizedImageUrl(src, size){
    if(!src) return '';
    return src.replace(/(\.[^.]+)$/, '_'+size+'$1').replace('http:', 'https:');
  }

  /* Quantity + remove actions */
  function bindItemActions(){
    document.querySelectorAll('.fh-qty-btn').forEach(function(btn){
      btn.onclick = function(){
        var line = parseInt(this.dataset.line);
        var action = this.dataset.action;
        var qtyEl = this.parentElement.querySelector('.fh-qty-val');
        var qty = parseInt(qtyEl.textContent);
        var newQty = action === 'plus' ? qty + 1 : Math.max(0, qty - 1);
        fetch('/cart/change.js', {
          method: 'POST',
          headers: {'Content-Type':'application/json'},
          body: JSON.stringify({line: line, quantity: newQty})
        }).then(function(){ refreshDrawer(); });
      };
    });
    document.querySelectorAll('.fh-drawer-item-remove').forEach(function(btn){
      btn.onclick = function(){
        var line = parseInt(this.dataset.line);
        fetch('/cart/change.js', {
          method: 'POST',
          headers: {'Content-Type':'application/json'},
          body: JSON.stringify({line: line, quantity: 0})
        }).then(function(){ refreshDrawer(); });
      };
    });
  }
  bindItemActions();

  /* Intercept add-to-cart form */
  document.addEventListener('submit', function(e){
    var form = e.target;
    if(form.id !== 'fh-product-form') return;
    e.preventDefault();
    var formData = new FormData(form);
    var addBtn = form.querySelector('.fh-bb-add');
    if(addBtn){ addBtn.textContent = '✓ Ajouté !'; addBtn.style.background = '#d4a843'; addBtn.style.color = '#0d1b2a'; }

    fetch('/cart/add.js', {
      method: 'POST',
      body: formData
    }).then(function(r){ return r.json(); }).then(function(){
      refreshDrawer();
      openDrawer();
      setTimeout(function(){
        if(addBtn){ addBtn.textContent = '⚽ Ajouter au panier'; addBtn.style.background = ''; addBtn.style.color = ''; }
      }, 2000);
    }).catch(function(){
      if(addBtn){ addBtn.textContent = '⚽ Ajouter au panier'; addBtn.style.background = ''; addBtn.style.color = ''; }
    });
  });

  /* Initial cross-sell render */
  renderCrossSell({{ cart.items | json }});
  if({{ cart.item_count }} === 0) document.getElementById('fh-drawer-footer').style.display = 'none';
})();
</script>
