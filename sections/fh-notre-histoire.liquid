{% comment %}
  Section: Notre Histoire — page complète immersive
{% endcomment %}

<div id="shopify-section-{{ section.id }}">

  {%- comment -%} ── HERO ── {%- endcomment -%}
  <section class="fh-sh-hero">
    <div class="fh-sh-hero-bg"></div>
    <div class="fh-sh-hero-inner">
      <div class="fh-sh-overline">{{ section.settings.hero_overline }}</div>
      <h1 class="fh-sh-h1">{{ section.settings.hero_title }}</h1>
      <p class="fh-sh-hero-sub">{{ section.settings.hero_subtitle }}</p>
    </div>
  </section>

  {%- comment -%} ── ORIGIN ── {%- endcomment -%}
  <section class="fh-sh-origin">
    <div class="fh-sh-origin-inner">
      <div class="fh-sh-origin-text">
        <div class="fh-sh-label">{{ section.settings.origin_label }}</div>
        <h2 class="fh-sh-h2">{{ section.settings.origin_title }}</h2>
        {% for block in section.blocks %}
          {% if block.type == 'origin_paragraph' %}
            <p class="fh-sh-p" {{ block.shopify_attributes }}>{{ block.settings.text }}</p>
          {% endif %}
        {% endfor %}
      </div>
      <div class="fh-sh-origin-visual">
        <div class="fh-sh-quote-card">
          <span class="fh-sh-quote-mark">"</span>
          <p class="fh-sh-quote-text">{{ section.settings.quote_text }}</p>
          <div class="fh-sh-quote-author">— {{ section.settings.quote_author }}</div>
        </div>
      </div>
    </div>
  </section>

  {%- comment -%} ── VALUES ── {%- endcomment -%}
  <section class="fh-sh-values">
    <div class="fh-sh-values-inner">
      <div class="fh-sh-label" style="text-align:center">{{ section.settings.values_label }}</div>
      <h2 class="fh-sh-h2" style="text-align:center;margin-bottom:48px">{{ section.settings.values_title }}</h2>
      <div class="fh-sh-values-grid">
        {% for block in section.blocks %}
          {% if block.type == 'value_card' %}
            <div class="fh-sh-value-card" {{ block.shopify_attributes }}>
              <span class="fh-sh-value-icon">{{ block.settings.icon }}</span>
              <h3 class="fh-sh-value-title">{{ block.settings.title }}</h3>
              <p class="fh-sh-value-text">{{ block.settings.text }}</p>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </section>

  {%- comment -%} ── TIMELINE ── {%- endcomment -%}
  <section class="fh-sh-timeline">
    <div class="fh-sh-timeline-inner">
      <div class="fh-sh-label" style="text-align:center;color:#d4a843">{{ section.settings.timeline_label }}</div>
      <h2 class="fh-sh-h2" style="text-align:center;color:#fff;margin-bottom:48px">{{ section.settings.timeline_title }}</h2>
      <div class="fh-sh-tl-track">
        {% for block in section.blocks %}
          {% if block.type == 'timeline_step' %}
            <div class="fh-sh-tl-item {% cycle 'fh-tl-left', 'fh-tl-right' %}" {{ block.shopify_attributes }}>
              <div class="fh-sh-tl-dot"></div>
              <div class="fh-sh-tl-card">
                <div class="fh-sh-tl-date">{{ block.settings.date }}</div>
                <h3 class="fh-sh-tl-title">{{ block.settings.title }}</h3>
                <p class="fh-sh-tl-text">{{ block.settings.text }}</p>
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </section>

  {%- comment -%} ── CTA ── {%- endcomment -%}
  <section class="fh-sh-cta">
    <div class="fh-sh-cta-inner">
      <h2 class="fh-sh-cta-title">{{ section.settings.cta_title }}</h2>
      <p class="fh-sh-cta-sub">{{ section.settings.cta_subtitle }}</p>
      <a href="{{ section.settings.cta_link | default: '/collections' }}" class="fh-sh-cta-btn">{{ section.settings.cta_button }} &rarr;</a>
    </div>
  </section>

  <style>
    /* ── HERO ── */
    #shopify-section-{{ section.id }} .fh-sh-hero{background:#0d1b2a;padding:120px 48px 100px;text-align:center;position:relative;overflow:hidden}
    #shopify-section-{{ section.id }} .fh-sh-hero-bg{position:absolute;inset:0;background:radial-gradient(ellipse at 50% 80%,rgba(212,168,67,0.08),transparent 60%),radial-gradient(ellipse at 20% 20%,rgba(29,53,87,0.2),transparent 50%)}
    #shopify-section-{{ section.id }} .fh-sh-hero-inner{position:relative;z-index:2;max-width:700px;margin:0 auto}
    #shopify-section-{{ section.id }} .fh-sh-overline{font-family:'Inter',sans-serif;font-size:11px;text-transform:uppercase;letter-spacing:4px;font-weight:700;color:#d4a843;margin-bottom:20px}
    #shopify-section-{{ section.id }} .fh-sh-h1{font-family:'Bebas Neue',Impact,sans-serif;font-size:80px;line-height:1;letter-spacing:3px;text-transform:uppercase;color:#fff;margin-bottom:20px}
    #shopify-section-{{ section.id }} .fh-sh-hero-sub{font-family:'Inter',sans-serif;font-size:17px;color:rgba(255,255,255,0.45);line-height:1.7;font-weight:300;max-width:520px;margin:0 auto}

    /* ── SHARED ── */
    #shopify-section-{{ section.id }} .fh-sh-label{font-family:'Inter',sans-serif;font-size:11px;text-transform:uppercase;letter-spacing:4px;font-weight:700;color:#d4a843;margin-bottom:12px}
    #shopify-section-{{ section.id }} .fh-sh-h2{font-family:'Bebas Neue',Impact,sans-serif;font-size:48px;letter-spacing:2px;text-transform:uppercase;color:#0d1b2a;line-height:1.1;margin-bottom:24px}
    #shopify-section-{{ section.id }} .fh-sh-p{font-family:'Inter',sans-serif;font-size:16px;color:#555;line-height:1.8;font-weight:300;margin-bottom:18px}

    /* ── ORIGIN ── */
    #shopify-section-{{ section.id }} .fh-sh-origin{padding:100px 48px;background:#fff}
    #shopify-section-{{ section.id }} .fh-sh-origin-inner{max-width:1100px;margin:0 auto;display:flex;gap:64px;align-items:flex-start}
    #shopify-section-{{ section.id }} .fh-sh-origin-text{flex:1.3}
    #shopify-section-{{ section.id }} .fh-sh-origin-visual{flex:1;position:sticky;top:120px}
    #shopify-section-{{ section.id }} .fh-sh-quote-card{background:#f5f5f3;border-radius:20px;padding:40px;position:relative}
    #shopify-section-{{ section.id }} .fh-sh-quote-mark{font-family:'Bebas Neue',Impact,sans-serif;font-size:120px;color:#d4a843;opacity:.2;position:absolute;top:-10px;left:20px;line-height:1}
    #shopify-section-{{ section.id }} .fh-sh-quote-text{font-family:'Inter',sans-serif;font-size:18px;color:#0d1b2a;line-height:1.7;font-weight:400;font-style:italic;position:relative;z-index:1}
    #shopify-section-{{ section.id }} .fh-sh-quote-author{font-family:'Inter',sans-serif;font-size:13px;color:#999;margin-top:16px;font-weight:600;text-transform:uppercase;letter-spacing:1px}

    /* ── VALUES ── */
    #shopify-section-{{ section.id }} .fh-sh-values{padding:100px 48px;background:#f5f5f3}
    #shopify-section-{{ section.id }} .fh-sh-values-inner{max-width:1100px;margin:0 auto}
    #shopify-section-{{ section.id }} .fh-sh-values-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}
    #shopify-section-{{ section.id }} .fh-sh-value-card{background:#fff;border-radius:16px;padding:36px;text-align:center;transition:transform .3s}
    #shopify-section-{{ section.id }} .fh-sh-value-card:hover{transform:translateY(-4px)}
    #shopify-section-{{ section.id }} .fh-sh-value-icon{font-size:40px;display:block;margin-bottom:16px}
    #shopify-section-{{ section.id }} .fh-sh-value-title{font-family:'Bebas Neue',Impact,sans-serif;font-size:24px;color:#0d1b2a;letter-spacing:1px;margin-bottom:10px}
    #shopify-section-{{ section.id }} .fh-sh-value-text{font-family:'Inter',sans-serif;font-size:14px;color:#777;line-height:1.7;font-weight:300}

    /* ── TIMELINE ── */
    #shopify-section-{{ section.id }} .fh-sh-timeline{padding:100px 48px;background:#0d1b2a}
    #shopify-section-{{ section.id }} .fh-sh-timeline-inner{max-width:800px;margin:0 auto}
    #shopify-section-{{ section.id }} .fh-sh-tl-track{position:relative;padding-left:40px}
    #shopify-section-{{ section.id }} .fh-sh-tl-track::before{content:'';position:absolute;left:11px;top:0;bottom:0;width:2px;background:rgba(212,168,67,0.2)}
    #shopify-section-{{ section.id }} .fh-sh-tl-item{position:relative;margin-bottom:40px}
    #shopify-section-{{ section.id }} .fh-sh-tl-dot{position:absolute;left:-33px;top:6px;width:12px;height:12px;border-radius:50%;background:#d4a843;border:3px solid #0d1b2a;z-index:1}
    #shopify-section-{{ section.id }} .fh-sh-tl-card{background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.06);border-radius:12px;padding:24px 28px}
    #shopify-section-{{ section.id }} .fh-sh-tl-date{font-family:'Bebas Neue',Impact,sans-serif;font-size:20px;color:#d4a843;letter-spacing:2px;margin-bottom:4px}
    #shopify-section-{{ section.id }} .fh-sh-tl-title{font-family:'Inter',sans-serif;font-size:16px;font-weight:700;color:#fff;margin-bottom:8px}
    #shopify-section-{{ section.id }} .fh-sh-tl-text{font-family:'Inter',sans-serif;font-size:14px;color:rgba(255,255,255,0.45);line-height:1.7;font-weight:300}

    /* ── CTA ── */
    #shopify-section-{{ section.id }} .fh-sh-cta{padding:100px 48px;background:#fff;text-align:center}
    #shopify-section-{{ section.id }} .fh-sh-cta-inner{max-width:600px;margin:0 auto}
    #shopify-section-{{ section.id }} .fh-sh-cta-title{font-family:'Bebas Neue',Impact,sans-serif;font-size:52px;color:#0d1b2a;letter-spacing:2px;text-transform:uppercase;line-height:1.1;margin-bottom:16px}
    #shopify-section-{{ section.id }} .fh-sh-cta-sub{font-family:'Inter',sans-serif;font-size:16px;color:#777;line-height:1.7;font-weight:300;margin-bottom:32px}
    #shopify-section-{{ section.id }} .fh-sh-cta-btn{display:inline-flex;align-items:center;gap:10px;background:#0d1b2a;color:#fff;padding:18px 40px;border-radius:8px;font-size:13px;font-weight:800;text-decoration:none;text-transform:uppercase;letter-spacing:2px;transition:all .3s;box-shadow:0 8px 32px rgba(13,27,42,0.2)}
    #shopify-section-{{ section.id }} .fh-sh-cta-btn:hover{transform:translateY(-2px);box-shadow:0 16px 48px rgba(13,27,42,0.35);background:#162d4a}

    /* ── RESPONSIVE ── */
    @media(max-width:900px){
      #shopify-section-{{ section.id }} .fh-sh-hero{padding:80px 20px 60px}
      #shopify-section-{{ section.id }} .fh-sh-h1{font-size:52px}
      #shopify-section-{{ section.id }} .fh-sh-origin{padding:64px 20px}
      #shopify-section-{{ section.id }} .fh-sh-origin-inner{flex-direction:column}
      #shopify-section-{{ section.id }} .fh-sh-origin-visual{position:static}
      #shopify-section-{{ section.id }} .fh-sh-values{padding:64px 20px}
      #shopify-section-{{ section.id }} .fh-sh-values-grid{grid-template-columns:1fr}
      #shopify-section-{{ section.id }} .fh-sh-timeline{padding:64px 20px}
      #shopify-section-{{ section.id }} .fh-sh-h2{font-size:36px}
      #shopify-section-{{ section.id }} .fh-sh-cta{padding:64px 20px}
      #shopify-section-{{ section.id }} .fh-sh-cta-title{font-size:36px}
    }
  </style>
</div>

{% schema %}
{
  "name": "Notre Histoire (page)",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Hero" },
    { "type": "text", "id": "hero_overline", "label": "Surtitre", "default": "Notre histoire" },
    { "type": "text", "id": "hero_title", "label": "Titre", "default": "Nés entre deux cultures" },
    { "type": "textarea", "id": "hero_subtitle", "label": "Sous-titre", "default": "On a grandi en vibrant pour deux équipes. Football Heritage est né de cette double fierté." },
    { "type": "header", "content": "Citation" },
    { "type": "textarea", "id": "quote_text", "label": "Citation", "default": "Le foot, c'est pas juste un sport. C'est 90 minutes où tout un pays vibre ensemble. C'est les cris dans les salons, les klaxons dans les rues, les larmes de joie." },
    { "type": "text", "id": "quote_author", "label": "Auteur", "default": "L'équipe Football Heritage" },
    { "type": "header", "content": "Origine" },
    { "type": "text", "id": "origin_label", "label": "Label", "default": "L'origine" },
    { "type": "text", "id": "origin_title", "label": "Titre", "default": "Comment tout a commencé" },
    { "type": "header", "content": "Valeurs" },
    { "type": "text", "id": "values_label", "label": "Label", "default": "Nos valeurs" },
    { "type": "text", "id": "values_title", "label": "Titre", "default": "Ce qui nous anime" },
    { "type": "header", "content": "Timeline" },
    { "type": "text", "id": "timeline_label", "label": "Label", "default": "Notre parcours" },
    { "type": "text", "id": "timeline_title", "label": "Titre", "default": "Les étapes clés" },
    { "type": "header", "content": "CTA final" },
    { "type": "text", "id": "cta_title", "label": "Titre", "default": "Prêt à porter tes origines ?" },
    { "type": "textarea", "id": "cta_subtitle", "label": "Sous-titre", "default": "Rejoins la communauté Football Heritage. Coupe du Monde 2026, on y sera. Et toi ?" },
    { "type": "text", "id": "cta_button", "label": "Bouton", "default": "Shopper la collection" },
    { "type": "text", "id": "cta_link", "label": "Lien", "default": "/collections" }
  ],
  "blocks": [
    {
      "type": "origin_paragraph",
      "name": "Paragraphe origine",
      "settings": [
        { "type": "textarea", "id": "text", "label": "Texte" }
      ]
    },
    {
      "type": "value_card",
      "name": "Carte valeur",
      "settings": [
        { "type": "text", "id": "icon", "label": "Emoji", "default": "⚽" },
        { "type": "text", "id": "title", "label": "Titre" },
        { "type": "textarea", "id": "text", "label": "Description" }
      ]
    },
    {
      "type": "timeline_step",
      "name": "Étape timeline",
      "settings": [
        { "type": "text", "id": "date", "label": "Date", "default": "2024" },
        { "type": "text", "id": "title", "label": "Titre" },
        { "type": "textarea", "id": "text", "label": "Description" }
      ]
    }
  ],
  "presets": [{ "name": "Notre Histoire (page)" }]
}
{% endschema %}
