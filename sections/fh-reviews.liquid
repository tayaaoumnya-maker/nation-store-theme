{% comment %}
  Section: Nos Avis — Page dédiée aux avis clients
{% endcomment %}

<div id="shopify-section-{{ section.id }}">
  <section class="fh-reviews-page" style="background:{{ section.settings.bg_color }}">
    <div class="fh-reviews-inner">
      <div class="fh-section-header">
        <div class="fh-section-overline" style="color:{{ section.settings.accent_color }}">{{ section.settings.overline }}</div>
        <div class="fh-reviews-title">{{ section.settings.title }}</div>
        <div class="fh-reviews-subtitle">{{ section.settings.subtitle }}</div>
        <div class="fh-reviews-stars">
          <span class="fh-stars-display">★★★★★</span>
          <span class="fh-stars-score">{{ section.settings.score }}</span>
        </div>
      </div>

      <div class="fh-reviews-grid">
        {% for block in section.blocks %}
          <div class="fh-review-card" {{ block.shopify_attributes }}>
            <div class="fh-review-stars">
              {% for i in (1..block.settings.stars) %}★{% endfor %}
            </div>
            <p class="fh-review-text">{{ block.settings.text }}</p>
            <div class="fh-review-author">
              <div class="fh-review-avatar" style="background:{{ section.settings.accent_color }}">{{ block.settings.initials }}</div>
              <div>
                <div class="fh-review-name">{{ block.settings.name }}</div>
                <div class="fh-review-loc">{{ block.settings.location }}{% if block.settings.verified %} · <span style="color:{{ section.settings.accent_color }}">✓ Vérifié</span>{% endif %}</div>
              </div>
            </div>
            {% if block.settings.product != blank %}
              <div class="fh-review-product">{{ block.settings.product }}</div>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    </div>
  </section>

  <style>
    #shopify-section-{{ section.id }} .fh-reviews-page{padding:80px 48px}
    #shopify-section-{{ section.id }} .fh-reviews-inner{max-width:1100px;margin:0 auto}
    #shopify-section-{{ section.id }} .fh-section-header{text-align:center;margin-bottom:56px}
    #shopify-section-{{ section.id }} .fh-section-overline{font-size:11px;text-transform:uppercase;letter-spacing:4px;font-weight:700;margin-bottom:12px}
    #shopify-section-{{ section.id }} .fh-reviews-title{font-family:'Bebas Neue',Impact,sans-serif;font-size:52px;letter-spacing:2px;text-transform:uppercase;color:#0d1b2a;margin-bottom:8px}
    #shopify-section-{{ section.id }} .fh-reviews-subtitle{font-size:15px;color:#777;font-weight:300;font-family:'Inter',sans-serif;margin-bottom:16px}
    #shopify-section-{{ section.id }} .fh-reviews-stars{display:flex;align-items:center;justify-content:center;gap:8px}
    #shopify-section-{{ section.id }} .fh-stars-display{font-size:24px;color:#d4a843}
    #shopify-section-{{ section.id }} .fh-stars-score{font-family:'Bebas Neue',Impact,sans-serif;font-size:28px;color:#0d1b2a}
    #shopify-section-{{ section.id }} .fh-reviews-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:24px}
    #shopify-section-{{ section.id }} .fh-review-card{background:#f5f5f3;border-radius:16px;padding:28px;font-family:'Inter',sans-serif;transition:transform .3s}
    #shopify-section-{{ section.id }} .fh-review-card:hover{transform:translateY(-4px)}
    #shopify-section-{{ section.id }} .fh-review-stars{color:#d4a843;font-size:16px;margin-bottom:12px;letter-spacing:2px}
    #shopify-section-{{ section.id }} .fh-review-text{font-size:15px;color:#444;line-height:1.7;font-weight:300;margin-bottom:20px;font-style:italic}
    #shopify-section-{{ section.id }} .fh-review-author{display:flex;align-items:center;gap:12px}
    #shopify-section-{{ section.id }} .fh-review-avatar{width:40px;height:40px;border-radius:50%;display:flex;align-items:center;justify-content:center;color:#0d1b2a;font-size:13px;font-weight:800}
    #shopify-section-{{ section.id }} .fh-review-name{font-size:14px;font-weight:600;color:#0d1b2a}
    #shopify-section-{{ section.id }} .fh-review-loc{font-size:12px;color:#999}
    #shopify-section-{{ section.id }} .fh-review-product{margin-top:12px;padding-top:12px;border-top:1px solid rgba(0,0,0,0.06);font-size:12px;color:#999;text-transform:uppercase;letter-spacing:1px}
    @media(max-width:600px){
      #shopify-section-{{ section.id }} .fh-reviews-page{padding:48px 16px}
      #shopify-section-{{ section.id }} .fh-reviews-title{font-size:36px}
      #shopify-section-{{ section.id }} .fh-reviews-grid{grid-template-columns:1fr}
    }
  </style>
</div>

{% schema %}
{
  "name": "Nos Avis",
  "tag": "section",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Fond", "default": "#ffffff" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#d4a843" },
    { "type": "text", "id": "overline", "label": "Surtitre", "default": "★ Avis clients" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Ce qu'ils en pensent" },
    { "type": "text", "id": "subtitle", "label": "Sous-titre", "default": "Des centaines de clients satisfaits à travers l'Europe" },
    { "type": "text", "id": "score", "label": "Note globale", "default": "4,8/5" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Avis",
      "settings": [
        { "type": "range", "id": "stars", "min": 1, "max": 5, "default": 5, "label": "Étoiles" },
        { "type": "textarea", "id": "text", "label": "Texte de l'avis" },
        { "type": "text", "id": "initials", "label": "Initiales", "default": "AB" },
        { "type": "text", "id": "name", "label": "Nom", "default": "Client" },
        { "type": "text", "id": "location", "label": "Ville", "default": "Paris" },
        { "type": "checkbox", "id": "verified", "label": "Achat vérifié", "default": true },
        { "type": "text", "id": "product", "label": "Produit (optionnel)" }
      ]
    }
  ],
  "presets": [{ "name": "Nos Avis" }]
}
{% endschema %}
