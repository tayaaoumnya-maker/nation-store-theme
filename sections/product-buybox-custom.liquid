{% comment %}
  Section: Product Buybox Custom — style Comma Football
  Gallery + infos + tailles + ATC + paiement + accordéons
{% endcomment %}

<div id="shopify-section-{{ section.id }}">
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <section class="fh-bb">
    {%- assign cv = product.selected_or_first_available_variant -%}
    {%- if cv.compare_at_price > cv.price -%}
      {%- assign save_pct = cv.compare_at_price | minus: cv.price | times: 100 | divided_by: cv.compare_at_price -%}
    {%- endif -%}

    <!-- ═══ GALLERY ═══ -->
    <div class="fh-bb-gal">
      <div class="fh-bb-gal-main" id="fh-gal-main">
        {% if section.settings.show_badge %}
          <span class="fh-bb-badge">{{ section.settings.badge_text }}</span>
        {% endif %}
        {% if save_pct %}
          <span class="fh-bb-disc">-{{ save_pct }}%</span>
        {% endif %}
        <button class="fh-bb-arrow fh-bb-arrow-l" data-gal-prev>&#8249;</button>
        <button class="fh-bb-arrow fh-bb-arrow-r" data-gal-next>&#8250;</button>
        <div class="fh-bb-gal-viewport">
          {% if product.featured_image != blank %}
            {{ product.featured_image | image_url: width: 960 | image_tag: loading: 'eager', class: 'fh-bb-main-img', id: 'fh-main-img' }}
          {% else %}
            <span class="fh-bb-flag-fb">{{ section.settings.flag_emoji }}</span>
          {% endif %}
        </div>
      </div>
      <div class="fh-bb-thumbs">
        {% for image in product.images %}
          <div class="fh-bb-thumb{% if forloop.first %} active{% endif %}" data-idx="{{ forloop.index0 }}" data-src="{{ image | image_url: width: 960 }}">
            {{ image | image_url: width: 120 | image_tag: loading: 'lazy' }}
          </div>
        {% endfor %}
      </div>
    </div>

    <!-- ═══ INFO ═══ -->
    <div class="fh-bb-info">
      <div class="fh-bb-crumb">
        <a href="/">Accueil</a> <span>/</span>
        {% if product.collections.first %}
          <a href="{{ product.collections.first.url }}">{{ product.collections.first.title }}</a> <span>/</span>
        {% endif %}
        <span>{{ product.title }}</span>
      </div>

      <div class="fh-bb-rating">
        <span class="fh-bb-stars-row">★★★★★</span>
        <span class="fh-bb-rev-count">{{ section.settings.reviews_summary }}</span>
      </div>

      <h1 class="fh-bb-name">{{ product.title }}</h1>
      <div class="fh-bb-sub">{{ section.settings.edition_text }}</div>

      <div class="fh-bb-price-row">
        <span class="fh-bb-price">{{ cv.price | money }}</span>
        {% if cv.compare_at_price > cv.price %}
          <span class="fh-bb-old">{{ cv.compare_at_price | money }}</span>
        {% endif %}
      </div>

      <!-- Size selector -->
      {%- form 'product', product, id: 'fh-product-form', novalidate: 'novalidate' -%}
        <input type="hidden" name="id" value="{{ cv.id }}" id="fh-variant-id">
        {% for option in product.options_with_values %}
          <div class="fh-bb-opt">
            <div class="fh-bb-opt-top">
              <span class="fh-bb-opt-label">{{ option.name }}</span>
              {% if option.name == 'Taille' or option.name == 'Size' %}
                <a href="/pages/guide-tailles" class="fh-bb-size-link">📏 Guide des tailles</a>
              {% endif %}
            </div>
            <div class="fh-bb-opt-btns">
              {% for value in option.values %}
                <button type="button" class="fh-bb-sz{% if value == option.selected_value %} sel{% endif %}" data-opt="{{ forloop.parentloop.index0 }}" data-val="{{ value }}">{{ value }}</button>
              {% endfor %}
            </div>
          </div>
        {% endfor %}

        <button type="submit" class="fh-bb-atc" {% unless cv.available %}disabled{% endunless %}>
          {% if cv.available %}
            AJOUTER AU PANIER — {{ cv.price | money }}
          {% else %}
            RUPTURE DE STOCK
          {% endif %}
        </button>
      {%- endform -%}

      <!-- Payment icons -->
      <div class="fh-bb-pay">
        <span class="fh-bb-pay-ic">💳</span>
        <span class="fh-bb-pay-ic">🍎</span>
        <span class="fh-bb-pay-ic">G</span>
        <span class="fh-bb-pay-text">Paiement sécurisé — CB, Apple Pay, Google Pay, PayPal</span>
      </div>

      <!-- Accordions -->
      <div class="fh-bb-accords">
        {% for block in section.blocks %}
          {% if block.type == 'accordion' %}
            <div class="fh-bb-acc" {{ block.shopify_attributes }}>
              <button class="fh-bb-acc-btn" data-acc-toggle>
                <span>{{ block.settings.title }}</span>
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M3 5.5l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
              </button>
              <div class="fh-bb-acc-body">
                <div class="fh-bb-acc-inner">{{ block.settings.content }}</div>
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </section>

  <style>
    #shopify-section-{{ section.id }} *{box-sizing:border-box}
    #shopify-section-{{ section.id }} .fh-bb{max-width:1240px;margin:0 auto;padding:32px 48px 64px;display:flex;gap:56px;align-items:flex-start}

    /* GALLERY */
    #shopify-section-{{ section.id }} .fh-bb-gal{flex:1.15;min-width:0;position:sticky;top:100px}
    #shopify-section-{{ section.id }} .fh-bb-gal-main{position:relative;aspect-ratio:3/4;background:#fff;border-radius:16px;overflow:hidden}
    #shopify-section-{{ section.id }} .fh-bb-gal-viewport{width:100%;height:100%;display:flex;align-items:center;justify-content:center}
    #shopify-section-{{ section.id }} .fh-bb-main-img{width:100%;height:100%;object-fit:contain;padding:24px;transition:opacity .3s}
    #shopify-section-{{ section.id }} .fh-bb-flag-fb{font-size:180px}
    #shopify-section-{{ section.id }} .fh-bb-badge{position:absolute;top:16px;left:16px;z-index:3;background:#0d1b2a;color:#fff;font-size:10px;font-weight:800;padding:6px 14px;border-radius:4px;text-transform:uppercase;letter-spacing:1.5px;font-family:'Inter',sans-serif}
    #shopify-section-{{ section.id }} .fh-bb-disc{position:absolute;top:16px;right:16px;z-index:3;background:#d4a843;color:#0d1b2a;font-size:11px;font-weight:800;padding:6px 12px;border-radius:4px;font-family:'Inter',sans-serif}
    #shopify-section-{{ section.id }} .fh-bb-arrow{position:absolute;top:50%;transform:translateY(-50%);z-index:4;width:40px;height:40px;border-radius:50%;border:none;background:rgba(255,255,255,0.9);color:#0d1b2a;font-size:22px;cursor:pointer;display:flex;align-items:center;justify-content:center;box-shadow:0 2px 8px rgba(0,0,0,0.1);transition:all .2s;backdrop-filter:blur(4px)}
    #shopify-section-{{ section.id }} .fh-bb-arrow:hover{background:#fff;box-shadow:0 4px 16px rgba(0,0,0,0.15)}
    #shopify-section-{{ section.id }} .fh-bb-arrow-l{left:12px}
    #shopify-section-{{ section.id }} .fh-bb-arrow-r{right:12px}
    #shopify-section-{{ section.id }} .fh-bb-thumbs{display:flex;gap:10px;margin-top:14px;overflow-x:auto;scrollbar-width:none;-ms-overflow-style:none}
    #shopify-section-{{ section.id }} .fh-bb-thumbs::-webkit-scrollbar{display:none}
    #shopify-section-{{ section.id }} .fh-bb-thumb{width:72px;height:90px;border-radius:10px;border:2px solid #e8e8e5;cursor:pointer;overflow:hidden;flex-shrink:0;transition:all .2s}
    #shopify-section-{{ section.id }} .fh-bb-thumb img{width:100%;height:100%;object-fit:cover}
    #shopify-section-{{ section.id }} .fh-bb-thumb:hover{border-color:#999}
    #shopify-section-{{ section.id }} .fh-bb-thumb.active{border-color:#0d1b2a}

    /* INFO */
    #shopify-section-{{ section.id }} .fh-bb-info{flex:1;min-width:0}
    #shopify-section-{{ section.id }} .fh-bb-crumb{font-size:12px;color:#999;margin-bottom:16px;font-family:'Inter',sans-serif;display:flex;gap:6px;flex-wrap:wrap}
    #shopify-section-{{ section.id }} .fh-bb-crumb a{color:#999;text-decoration:none;transition:color .2s}
    #shopify-section-{{ section.id }} .fh-bb-crumb a:hover{color:#0d1b2a}
    #shopify-section-{{ section.id }} .fh-bb-crumb span{color:#ccc}
    #shopify-section-{{ section.id }} .fh-bb-rating{display:flex;align-items:center;gap:10px;margin-bottom:10px}
    #shopify-section-{{ section.id }} .fh-bb-stars-row{color:#d4a843;font-size:15px;letter-spacing:1px}
    #shopify-section-{{ section.id }} .fh-bb-rev-count{font-size:13px;color:#777;font-family:'Inter',sans-serif}
    #shopify-section-{{ section.id }} .fh-bb-name{font-family:'Bebas Neue',Impact,sans-serif;font-size:40px;letter-spacing:2px;text-transform:uppercase;line-height:1.05;margin-bottom:4px;color:#0d1b2a}
    #shopify-section-{{ section.id }} .fh-bb-sub{font-size:13px;color:#999;font-family:'Inter',sans-serif;margin-bottom:16px}
    #shopify-section-{{ section.id }} .fh-bb-price-row{display:flex;align-items:baseline;gap:12px;margin-bottom:28px}
    #shopify-section-{{ section.id }} .fh-bb-price{font-size:24px;font-weight:800;color:#0d1b2a;font-family:'Inter',sans-serif}
    #shopify-section-{{ section.id }} .fh-bb-old{font-size:18px;color:#bbb;text-decoration:line-through;font-weight:400;font-family:'Inter',sans-serif}

    /* OPTIONS */
    #shopify-section-{{ section.id }} .fh-bb-opt{margin-bottom:24px}
    #shopify-section-{{ section.id }} .fh-bb-opt-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:10px}
    #shopify-section-{{ section.id }} .fh-bb-opt-label{font-size:13px;font-weight:700;text-transform:uppercase;letter-spacing:1.5px;color:#0d1b2a;font-family:'Inter',sans-serif}
    #shopify-section-{{ section.id }} .fh-bb-size-link{font-size:12px;color:#777;text-decoration:underline;font-family:'Inter',sans-serif;transition:color .2s}
    #shopify-section-{{ section.id }} .fh-bb-size-link:hover{color:#0d1b2a}
    #shopify-section-{{ section.id }} .fh-bb-opt-btns{display:flex;gap:8px;flex-wrap:wrap}
    #shopify-section-{{ section.id }} .fh-bb-sz{min-width:52px;padding:12px 16px;border:2px solid #e0e0dc;border-radius:8px;background:#fff;cursor:pointer;font-size:14px;font-weight:600;transition:all .2s;font-family:'Inter',sans-serif;color:#0d1b2a;text-align:center}
    #shopify-section-{{ section.id }} .fh-bb-sz:hover{border-color:#0d1b2a}
    #shopify-section-{{ section.id }} .fh-bb-sz.sel{border-color:#0d1b2a;background:#0d1b2a;color:#fff}

    /* ATC */
    #shopify-section-{{ section.id }} .fh-bb-atc{width:100%;padding:18px;background:#0d1b2a;color:#fff;border:none;border-radius:8px;font-size:14px;font-weight:800;cursor:pointer;text-transform:uppercase;letter-spacing:2px;font-family:'Inter',sans-serif;transition:all .3s;margin-bottom:14px}
    #shopify-section-{{ section.id }} .fh-bb-atc:hover{background:#162d4a;box-shadow:0 8px 30px rgba(13,27,42,0.3)}
    #shopify-section-{{ section.id }} .fh-bb-atc:disabled{opacity:.4;cursor:not-allowed}

    /* PAYMENT */
    #shopify-section-{{ section.id }} .fh-bb-pay{display:flex;align-items:center;gap:8px;padding:12px 0 24px;border-bottom:1px solid #eee;flex-wrap:wrap}
    #shopify-section-{{ section.id }} .fh-bb-pay-ic{width:32px;height:22px;background:#f5f5f3;border-radius:4px;display:flex;align-items:center;justify-content:center;font-size:13px}
    #shopify-section-{{ section.id }} .fh-bb-pay-text{font-size:11px;color:#999;font-family:'Inter',sans-serif}

    /* ACCORDIONS */
    #shopify-section-{{ section.id }} .fh-bb-accords{margin-top:0}
    #shopify-section-{{ section.id }} .fh-bb-acc{border-bottom:1px solid #eee}
    #shopify-section-{{ section.id }} .fh-bb-acc-btn{width:100%;background:none;border:none;text-align:left;padding:20px 0;font-size:15px;font-weight:700;color:#0d1b2a;cursor:pointer;display:flex;justify-content:space-between;align-items:center;font-family:'Inter',sans-serif;transition:color .2s}
    #shopify-section-{{ section.id }} .fh-bb-acc-btn:hover{color:#d4a843}
    #shopify-section-{{ section.id }} .fh-bb-acc-btn svg{transition:transform .3s;flex-shrink:0;color:#999}
    #shopify-section-{{ section.id }} .fh-bb-acc-btn.open svg{transform:rotate(180deg);color:#d4a843}
    #shopify-section-{{ section.id }} .fh-bb-acc-body{max-height:0;overflow:hidden;transition:max-height .4s ease}
    #shopify-section-{{ section.id }} .fh-bb-acc-body.open{max-height:600px}
    #shopify-section-{{ section.id }} .fh-bb-acc-inner{padding:0 0 20px;font-size:14px;color:#666;line-height:1.8;font-weight:400;font-family:'Inter',sans-serif}

    /* RESPONSIVE */
    @media(max-width:900px){
      #shopify-section-{{ section.id }} .fh-bb{flex-direction:column;padding:16px 20px 48px;gap:32px}
      #shopify-section-{{ section.id }} .fh-bb-gal{position:static}
      #shopify-section-{{ section.id }} .fh-bb-name{font-size:32px}
    }
  </style>

  <script>
    (function(){
      var s = document.getElementById('shopify-section-{{ section.id }}');
      var images = {{ product.images | json }};
      var imgUrls = [];
      {% for image in product.images %}
        imgUrls.push('{{ image | image_url: width: 960 }}');
      {% endfor %}
      var curIdx = 0;

      function showImg(idx){
        if(!imgUrls.length) return;
        curIdx = (idx + imgUrls.length) % imgUrls.length;
        var mainImg = s.querySelector('#fh-main-img');
        if(mainImg) mainImg.src = imgUrls[curIdx];
        s.querySelectorAll('.fh-bb-thumb').forEach(function(t,i){
          t.classList.toggle('active', i === curIdx);
        });
      }

      /* Arrows */
      var prevBtn = s.querySelector('[data-gal-prev]');
      var nextBtn = s.querySelector('[data-gal-next]');
      if(prevBtn) prevBtn.addEventListener('click', function(){ showImg(curIdx - 1); });
      if(nextBtn) nextBtn.addEventListener('click', function(){ showImg(curIdx + 1); });

      /* Thumbs */
      s.querySelectorAll('.fh-bb-thumb').forEach(function(t){
        t.addEventListener('click', function(){ showImg(parseInt(this.dataset.idx)); });
      });

      /* Variants */
      var variants = {{ product.variants | json }};
      s.querySelectorAll('.fh-bb-sz').forEach(function(btn){
        btn.addEventListener('click', function(){
          this.closest('.fh-bb-opt-btns').querySelectorAll('.fh-bb-sz').forEach(function(b){b.classList.remove('sel')});
          this.classList.add('sel');
          var sel = [];
          s.querySelectorAll('.fh-bb-opt-btns').forEach(function(g){
            var a = g.querySelector('.fh-bb-sz.sel');
            if(a) sel.push(a.dataset.val);
          });
          for(var i=0;i<variants.length;i++){
            var v=variants[i], ok=true;
            for(var j=0;j<sel.length;j++){
              if(v['option'+(j+1)]!==sel[j]){ok=false;break}
            }
            if(ok){
              document.getElementById('fh-variant-id').value=v.id;
              var atc=s.querySelector('.fh-bb-atc');
              if(atc){
                if(v.available){
                  atc.disabled=false;
                  atc.textContent='AJOUTER AU PANIER — '+(v.price/100).toFixed(2).replace('.',',')+' €';
                } else {
                  atc.disabled=true;
                  atc.textContent='RUPTURE DE STOCK';
                }
              }
              break;
            }
          }
        });
      });

      /* Accordions */
      s.querySelectorAll('[data-acc-toggle]').forEach(function(btn){
        btn.addEventListener('click', function(){
          this.classList.toggle('open');
          var body = this.nextElementSibling;
          if(body) body.classList.toggle('open');
        });
      });
    })();
  </script>
</div>

{% schema %}
{
  "name": "Buybox produit",
  "tag": "section",
  "class": "fh-buybox-section",
  "settings": [
    { "type": "text", "id": "flag_emoji", "label": "Emoji drapeau (fallback)", "default": "🇲🇦" },
    { "type": "text", "id": "reviews_summary", "label": "Résumé avis", "default": "4,8/5 — 127 avis" },
    { "type": "text", "id": "edition_text", "label": "Sous-titre", "default": "Édition Coupe du Monde 2026" },
    { "type": "checkbox", "id": "show_badge", "label": "Afficher badge", "default": true },
    { "type": "text", "id": "badge_text", "label": "Texte badge", "default": "🔥 Édition limitée" }
  ],
  "blocks": [
    {
      "type": "accordion",
      "name": "Section accordéon",
      "settings": [
        { "type": "text", "id": "title", "label": "Titre", "default": "Description" },
        { "type": "richtext", "id": "content", "label": "Contenu" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Buybox produit",
      "blocks": [
        { "type": "accordion", "settings": { "title": "Description", "content": "<p>Design exclusif qui célèbre tes racines. Tissu polyester premium ultra-respirant avec impression par sublimation HD. Les couleurs sont intégrées dans le tissu — elles ne fanent jamais.</p>" } },
        { "type": "accordion", "settings": { "title": "Taille & Coupe", "content": "<p>Taille normalement. En cas d'hésitation, prends la taille au-dessus pour un look décontracté. Coupe regular fit, confortable au stade comme en ville.</p>" } },
        { "type": "accordion", "settings": { "title": "Livraison", "content": "<p>Production 2-4 jours ouvrés + livraison 5-10 jours ouvrés en Europe. Suivi par email en temps réel. Livraison gratuite dès 50€.</p>" } },
        { "type": "accordion", "settings": { "title": "Garantie 30 jours", "content": "<p>Satisfait ou remboursé pendant 30 jours, sans conditions. Contacte-nous et on s'occupe de tout.</p>" } },
        { "type": "accordion", "settings": { "title": "Avertissement authenticité", "content": "<p>Ce n'est pas un maillot officiel. Design original indépendant, non affilié aux fédérations, à la FIFA ou aux équipementiers. Art fan premium.</p>" } }
      ]
    }
  ]
}
{% endschema %}
