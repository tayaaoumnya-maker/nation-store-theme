{% comment %}
  Section: Football Heritage Collection Product Grid
  Grille produits premium — fond clair, cards élégantes, 4 colonnes
{% endcomment %}

<div id="shopify-section-{{ section.id }}">
  <section class="fh-grid-section">
    <div class="fh-grid-inner">

      {%- paginate collection.products by section.settings.products_per_page -%}

        <div class="fh-grid-toolbar">
          <div class="fh-grid-results">
            {{ collection.products_count }} {{ collection.products_count | pluralize: 'produit', 'produits' }}
          </div>
          <div class="fh-grid-controls">
            {% if section.settings.enable_sorting %}
            <div class="fh-grid-sort">
              <label for="fh-sort-{{ section.id }}">Trier par</label>
              <select id="fh-sort-{{ section.id }}" onchange="window.location.href=this.value">
                {%- for option in collection.sort_options -%}
                  <option value="{{ collection.url }}?sort_by={{ option.value }}" {% if collection.sort_by == option.value or collection.default_sort_by == option.value and collection.sort_by == blank %}selected{% endif %}>
                    {{ option.name }}
                  </option>
                {%- endfor -%}
              </select>
            </div>
            {% endif %}
          </div>
        </div>

        {% if collection.products.size > 0 %}
        <div class="fh-product-grid">
          {%- for product in collection.products -%}
            <a href="{{ product.url }}" class="fh-product-card">
              <div class="fh-pc-image">
                {% if product.featured_image %}
                  <img
                    src="{{ product.featured_image | image_url: width: 800 }}"
                    alt="{{ product.featured_image.alt | escape }}"
                    width="800"
                    height="{{ 800 | divided_by: product.featured_image.aspect_ratio | round }}"
                    loading="lazy"
                  >
                  {% if product.images.size > 1 %}
                    <img
                      src="{{ product.images[1] | image_url: width: 800 }}"
                      alt="{{ product.images[1].alt | escape }}"
                      class="fh-pc-hover-img"
                      loading="lazy"
                    >
                  {% endif %}
                {% else %}
                  <div class="fh-pc-placeholder">
                    <svg viewBox="0 0 24 24" width="48" height="48" fill="none" stroke="currentColor" stroke-width="1"><rect x="2" y="2" width="20" height="20" rx="2"/><circle cx="8" cy="8" r="2"/><path d="m21 15-5-5L5 21"/></svg>
                  </div>
                {% endif %}
                {% if product.compare_at_price > product.price %}
                  {% assign discount = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price %}
                  <span class="fh-pc-badge">-{{ discount }}%</span>
                {% endif %}
                {% unless product.available %}
                  <span class="fh-pc-sold-out">Épuisé</span>
                {% endunless %}
              </div>
              <div class="fh-pc-info">
                <h3 class="fh-pc-title">{{ product.title }}</h3>
                <div class="fh-pc-price">
                  {% if product.compare_at_price > product.price %}
                    <span class="fh-pc-compare">{{ product.compare_at_price | money }}</span>
                  {% endif %}
                  <span class="fh-pc-current {% if product.compare_at_price > product.price %}fh-pc-sale{% endif %}">{{ product.price | money }}</span>
                </div>
              </div>
            </a>
          {%- endfor -%}
        </div>

        {% if paginate.pages > 1 %}
        <nav class="fh-pagination">
          {% if paginate.previous %}
            <a href="{{ paginate.previous.url }}" class="fh-page-arrow">&larr;</a>
          {% endif %}
          {% for part in paginate.parts %}
            {% if part.is_link %}
              <a href="{{ part.url }}" class="fh-page-num">{{ part.title }}</a>
            {% else %}
              {% if part.title == paginate.current_page %}
                <span class="fh-page-num fh-page-active">{{ part.title }}</span>
              {% else %}
                <span class="fh-page-num">{{ part.title }}</span>
              {% endif %}
            {% endif %}
          {% endfor %}
          {% if paginate.next %}
            <a href="{{ paginate.next.url }}" class="fh-page-arrow">&rarr;</a>
          {% endif %}
        </nav>
        {% endif %}

        {% else %}
        <div class="fh-empty">
          <div class="fh-empty-icon">🏟️</div>
          <p class="fh-empty-title">Bientôt disponible</p>
          <p class="fh-empty-sub">Les jerseys de cette collection arrivent très bientôt.</p>
          <a href="/collections" class="fh-empty-btn">Voir toutes les collections &rarr;</a>
        </div>
        {% endif %}

      {%- endpaginate -%}
    </div>
  </section>

  <style>
    #shopify-section-{{ section.id }} .fh-grid-section{padding:40px 48px 80px;background:#fff}
    #shopify-section-{{ section.id }} .fh-grid-inner{max-width:1280px;margin:0 auto}

    /* Toolbar */
    #shopify-section-{{ section.id }} .fh-grid-toolbar{display:flex;justify-content:space-between;align-items:center;margin-bottom:36px;padding-bottom:20px;border-bottom:1px solid #eee}
    #shopify-section-{{ section.id }} .fh-grid-results{font-family:'Inter',sans-serif;font-size:13px;color:#999;letter-spacing:.5px}
    #shopify-section-{{ section.id }} .fh-grid-controls{display:flex;align-items:center;gap:16px}
    #shopify-section-{{ section.id }} .fh-grid-sort{display:flex;align-items:center;gap:8px}
    #shopify-section-{{ section.id }} .fh-grid-sort label{font-family:'Inter',sans-serif;font-size:12px;color:#999;text-transform:uppercase;letter-spacing:1px}
    #shopify-section-{{ section.id }} .fh-grid-sort select{background:#fff;color:#0d1b2a;border:1px solid #ddd;border-radius:8px;padding:10px 16px;font-size:13px;font-family:'Inter',sans-serif;cursor:pointer;transition:border-color .3s}
    #shopify-section-{{ section.id }} .fh-grid-sort select:hover{border-color:#0d1b2a}

    /* Grid */
    #shopify-section-{{ section.id }} .fh-product-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:20px}

    /* Card */
    #shopify-section-{{ section.id }} .fh-product-card{text-decoration:none;display:block;transition:transform .35s}
    #shopify-section-{{ section.id }} .fh-product-card:hover{transform:translateY(-4px)}

    /* Image */
    #shopify-section-{{ section.id }} .fh-pc-image{position:relative;aspect-ratio:3/4;overflow:hidden;background:#ffffff;border-radius:12px;margin-bottom:14px}
    #shopify-section-{{ section.id }} .fh-pc-image img{width:100%;height:100%;object-fit:contain;padding:16px;transition:opacity .4s,transform .5s}
    #shopify-section-{{ section.id }} .fh-pc-hover-img{position:absolute;inset:0;opacity:0;object-fit:contain;padding:16px}
    #shopify-section-{{ section.id }} .fh-product-card:hover .fh-pc-image > img:first-child{opacity:0}
    #shopify-section-{{ section.id }} .fh-product-card:hover .fh-pc-hover-img{opacity:1}
    #shopify-section-{{ section.id }} .fh-product-card:hover .fh-pc-image img{transform:scale(1.04)}
    #shopify-section-{{ section.id }} .fh-pc-placeholder{width:100%;height:100%;display:flex;align-items:center;justify-content:center;color:#ddd}

    /* Badges */
    #shopify-section-{{ section.id }} .fh-pc-badge{position:absolute;top:12px;left:12px;background:#c1272d;color:#fff;font-size:11px;font-weight:700;padding:5px 10px;border-radius:6px;letter-spacing:.5px;z-index:2}
    #shopify-section-{{ section.id }} .fh-pc-sold-out{position:absolute;top:12px;right:12px;background:#0d1b2a;color:#fff;font-size:10px;font-weight:700;padding:5px 10px;border-radius:6px;text-transform:uppercase;letter-spacing:1px;z-index:2}

    /* Info */
    #shopify-section-{{ section.id }} .fh-pc-info{padding:0 4px}
    #shopify-section-{{ section.id }} .fh-pc-title{font-family:'Inter',sans-serif;font-size:14px;font-weight:500;color:#0d1b2a;margin-bottom:6px;line-height:1.4;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
    #shopify-section-{{ section.id }} .fh-pc-price{display:flex;align-items:center;gap:8px}
    #shopify-section-{{ section.id }} .fh-pc-compare{font-family:'Inter',sans-serif;font-size:14px;color:#bbb;text-decoration:line-through}
    #shopify-section-{{ section.id }} .fh-pc-current{font-family:'Inter',sans-serif;font-size:15px;color:#0d1b2a;font-weight:700}
    #shopify-section-{{ section.id }} .fh-pc-sale{color:#c1272d}

    /* Pagination */
    #shopify-section-{{ section.id }} .fh-pagination{display:flex;justify-content:center;align-items:center;gap:4px;margin-top:56px}
    #shopify-section-{{ section.id }} .fh-page-arrow{display:flex;align-items:center;justify-content:center;width:40px;height:40px;border-radius:50%;border:1px solid #ddd;text-decoration:none;color:#0d1b2a;font-size:16px;transition:all .3s}
    #shopify-section-{{ section.id }} .fh-page-arrow:hover{background:#0d1b2a;color:#fff;border-color:#0d1b2a}
    #shopify-section-{{ section.id }} .fh-page-num{font-family:'Inter',sans-serif;font-size:14px;color:#999;width:40px;height:40px;display:flex;align-items:center;justify-content:center;border-radius:50%;text-decoration:none;transition:all .3s}
    #shopify-section-{{ section.id }} .fh-page-num:hover{color:#0d1b2a;background:#f5f5f3}
    #shopify-section-{{ section.id }} .fh-page-active{background:#0d1b2a;color:#fff;font-weight:700}

    /* Empty state */
    #shopify-section-{{ section.id }} .fh-empty{text-align:center;padding:80px 20px}
    #shopify-section-{{ section.id }} .fh-empty-icon{font-size:64px;margin-bottom:20px}
    #shopify-section-{{ section.id }} .fh-empty-title{font-family:'Bebas Neue',Impact,sans-serif;font-size:36px;color:#0d1b2a;letter-spacing:2px;margin-bottom:8px}
    #shopify-section-{{ section.id }} .fh-empty-sub{font-family:'Inter',sans-serif;font-size:15px;color:#999;margin-bottom:28px}
    #shopify-section-{{ section.id }} .fh-empty-btn{display:inline-flex;align-items:center;gap:8px;background:#0d1b2a;color:#fff;padding:14px 28px;border-radius:8px;font-size:13px;font-weight:700;text-decoration:none;text-transform:uppercase;letter-spacing:1.5px;transition:all .3s}
    #shopify-section-{{ section.id }} .fh-empty-btn:hover{background:#162d4a;transform:translateY(-2px)}

    /* Responsive */
    @media(max-width:1100px){
      #shopify-section-{{ section.id }} .fh-product-grid{grid-template-columns:repeat(3,1fr)}
    }
    @media(max-width:768px){
      #shopify-section-{{ section.id }} .fh-grid-section{padding:24px 16px 60px}
      #shopify-section-{{ section.id }} .fh-product-grid{grid-template-columns:repeat(2,1fr);gap:12px}
      #shopify-section-{{ section.id }} .fh-grid-toolbar{flex-direction:column;gap:12px;align-items:flex-start}
      #shopify-section-{{ section.id }} .fh-pc-title{font-size:13px}
      #shopify-section-{{ section.id }} .fh-pc-image{border-radius:8px}
    }
  </style>
</div>

{% schema %}
{
  "name": "FH Product Grid",
  "tag": "section",
  "settings": [
    { "type": "range", "id": "products_per_page", "min": 8, "max": 32, "step": 4, "default": 16, "label": "Produits par page" },
    { "type": "checkbox", "id": "enable_sorting", "label": "Activer le tri", "default": true }
  ],
  "presets": [{ "name": "FH Product Grid" }]
}
{% endschema %}
