{% comment %}
  Section: Footer Custom
  Footer avec colonnes et copyright
{% endcomment %}

<div id="shopify-section-{{ section.id }}">
  <footer class="fh-footer" style="background:{{ section.settings.bg_color }}">
    <div class="fh-footer-grid">
      {% for block in section.blocks %}
        {% if block.type == 'column' %}
          <div class="fh-footer-col" {{ block.shopify_attributes }}>
            <h4>{{ block.settings.heading }}</h4>
            {% assign links = block.settings.links_text | split: '|' %}
            {% assign urls = block.settings.links_url | split: '|' %}
            {% for link_text in links %}
              {% assign raw_url = urls[forloop.index0] %}
              {% if raw_url == '/pages/guide-tailles' or raw_url == '/pages/guide-des-tailles' %}
                {% assign final_url = '/pages/page-produit' %}
              {% elsif raw_url == '/pages/livraison-retours' or raw_url == '/pages/livraison-et-retours' %}
                {% assign final_url = '/pages/livraison-retour' %}
              {% elsif raw_url == '/pages/nos-avis' %}
                {% assign final_url = '/pages/avis' %}
              {% elsif raw_url != blank %}
                {% assign final_url = raw_url %}
              {% else %}
                {% assign final_url = '#' %}
              {% endif %}
              <a href="{{ final_url }}">{{ link_text | strip }}</a>
            {% endfor %}
          </div>
        {% endif %}
      {% endfor %}
    </div>
    <div class="fh-footer-bottom">{{ section.settings.copyright }}</div>
  </footer>

  <style>
    #shopify-section-{{ section.id }} .fh-footer{color:rgba(255,255,255,0.85);padding:64px 48px 32px;border-top:1px solid rgba(255,255,255,0.08)}
    #shopify-section-{{ section.id }} .fh-footer-grid{max-width:1100px;margin:0 auto;display:flex;gap:64px;flex-wrap:wrap;margin-bottom:48px}
    #shopify-section-{{ section.id }} .fh-footer-col{flex:1;min-width:180px}
    #shopify-section-{{ section.id }} .fh-footer-col h4{color:#fff;font-size:11px;text-transform:uppercase;letter-spacing:2px;margin-bottom:20px;font-weight:700;font-family:'Inter',sans-serif}
    #shopify-section-{{ section.id }} .fh-footer-col a{display:block;color:rgba(255,255,255,0.8);text-decoration:none;font-size:13px;margin-bottom:10px;transition:color .3s;font-weight:300;font-family:'Inter',sans-serif}
    #shopify-section-{{ section.id }} .fh-footer-col a:hover{color:{{ section.settings.accent_color }}}
    #shopify-section-{{ section.id }} .fh-footer-bottom{text-align:center;padding-top:32px;border-top:1px solid rgba(255,255,255,0.04);font-size:12px;font-weight:300;font-family:'Inter',sans-serif}
  </style>
</div>

{% schema %}
{
  "name": "Footer custom",
  "tag": "section",
  "class": "fh-footer-section",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Couleur de fond",
      "default": "#0f1f30"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Couleur accent hover",
      "default": "#d4a843"
    },
    {
      "type": "text",
      "id": "copyright",
      "label": "Texte copyright",
      "default": "© 2026 Football Heritage · Propulsé par Shopify"
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Colonne",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Titre colonne",
          "default": "Football Heritage"
        },
        {
          "type": "textarea",
          "id": "links_text",
          "label": "Textes liens (séparés par |)",
          "default": "Accueil|Tous les produits|Notre histoire|Contact"
        },
        {
          "type": "textarea",
          "id": "links_url",
          "label": "URLs liens (séparés par |)",
          "default": "/|/collections/all|/pages/notre-histoire|/pages/contact"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Footer custom",
      "blocks": [
        { "type": "column", "settings": { "heading": "Football Heritage", "links_text": "Accueil|Tous les produits|Notre histoire|Contact", "links_url": "/|/collections/all|/pages/notre-histoire|/pages/contact" } },
        { "type": "column", "settings": { "heading": "Collections", "links_text": "Maroc|Algérie|Côte d'Ivoire|France|Brésil", "links_url": "/collections/maroc|/collections/algerie|/collections/cote-divoire|/collections/france|/collections/bresil" } },
        { "type": "column", "settings": { "heading": "Informations", "links_text": "Guide des tailles|Livraison & retours|CGV|Confidentialité", "links_url": "/pages/page-produit|/pages/livraison-retour|/policies/terms-of-service|/policies/privacy-policy" } },
        { "type": "column", "settings": { "heading": "Suivez-nous", "links_text": "Instagram|TikTok|YouTube|Pinterest", "links_url": "#|#|#|#" } }
      ]
    }
  ]
}
{% endschema %}
