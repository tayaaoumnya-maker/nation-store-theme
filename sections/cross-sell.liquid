{% comment %}
  Section: Cross-Sell
  Recommandation produits "Complète ta collection" sur page produit
{% endcomment %}

<div id="shopify-section-{{ section.id }}">
  <section class="fh-crosssell" style="background:{{ section.settings.bg_color }}">
    <div class="fh-crosssell-header">
      <div class="fh-crosssell-overline" style="color:{{ section.settings.accent_color }}">{{ section.settings.overline }}</div>
      <div class="fh-crosssell-title">{{ section.settings.title }}</div>
      {% if section.settings.subtitle != blank %}
        <div class="fh-crosssell-subtitle">{{ section.settings.subtitle }}</div>
      {% endif %}
    </div>
    <div class="fh-crosssell-grid">
      {% for block in section.blocks %}
        <a href="{{ block.settings.link }}" class="fh-crosssell-card" {{ block.shopify_attributes }}>
          <div class="fh-crosssell-card-bg" style="background:{{ block.settings.gradient }}">
            {% if block.settings.image != blank %}
              {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', class: 'fh-crosssell-img' }}
            {% else %}
              <span class="fh-crosssell-emoji">{{ block.settings.flag_emoji }}</span>
            {% endif %}
          </div>
          <div class="fh-crosssell-info">
            <div class="fh-crosssell-flag">{{ block.settings.flag_emoji }}</div>
            <div class="fh-crosssell-country">{{ block.settings.country }}</div>
            <div class="fh-crosssell-price" style="color:{{ section.settings.accent_color }}">{{ block.settings.price }}</div>
            <span class="fh-crosssell-btn" style="background:{{ section.settings.accent_color }}">Voir le jersey &rarr;</span>
          </div>
        </a>
      {% endfor %}
    </div>
  </section>

  <style>
    #shopify-section-{{ section.id }} .fh-crosssell{padding:100px 48px;position:relative;overflow:hidden}
    #shopify-section-{{ section.id }} .fh-crosssell::before{content:'';position:absolute;inset:0;background:radial-gradient(ellipse at 50% 0%,rgba(212,168,67,0.04),transparent 60%)}
    #shopify-section-{{ section.id }} .fh-crosssell-header{text-align:center;margin-bottom:56px;position:relative;z-index:1}
    #shopify-section-{{ section.id }} .fh-crosssell-overline{font-size:11px;text-transform:uppercase;letter-spacing:4px;font-weight:700;margin-bottom:12px}
    #shopify-section-{{ section.id }} .fh-crosssell-title{font-family:'Bebas Neue',Impact,sans-serif;font-size:52px;letter-spacing:2px;text-transform:uppercase;color:#0d1b2a}
    #shopify-section-{{ section.id }} .fh-crosssell-subtitle{font-size:14px;color:#777;margin-top:8px;font-weight:300;font-family:'Inter',sans-serif}
    #shopify-section-{{ section.id }} .fh-crosssell-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:20px;max-width:1200px;margin:0 auto;position:relative;z-index:1}
    #shopify-section-{{ section.id }} .fh-crosssell-card{border-radius:16px;overflow:hidden;position:relative;cursor:pointer;aspect-ratio:3/4;display:flex;align-items:flex-end;text-decoration:none;transition:transform .3s,box-shadow .3s}
    #shopify-section-{{ section.id }} .fh-crosssell-card:hover{transform:translateY(-6px) scale(1.02);box-shadow:0 20px 60px rgba(0,0,0,0.15)}
    #shopify-section-{{ section.id }} .fh-crosssell-card-bg{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;transition:transform .6s}
    #shopify-section-{{ section.id }} .fh-crosssell-card-bg .fh-crosssell-emoji{font-size:72px}
    #shopify-section-{{ section.id }} .fh-crosssell-card-bg .fh-crosssell-img{width:100%;height:100%;object-fit:cover}
    #shopify-section-{{ section.id }} .fh-crosssell-card:hover .fh-crosssell-card-bg{transform:scale(1.08)}
    #shopify-section-{{ section.id }} .fh-crosssell-card::after{content:'';position:absolute;inset:0;background:linear-gradient(180deg,transparent 20%,rgba(0,0,0,0.85) 100%)}
    #shopify-section-{{ section.id }} .fh-crosssell-info{position:relative;z-index:2;padding:24px;width:100%}
    #shopify-section-{{ section.id }} .fh-crosssell-flag{font-size:24px;margin-bottom:6px}
    #shopify-section-{{ section.id }} .fh-crosssell-country{font-family:'Bebas Neue',Impact,sans-serif;font-size:26px;letter-spacing:2px;text-transform:uppercase;color:#fff}
    #shopify-section-{{ section.id }} .fh-crosssell-price{font-size:15px;font-weight:600;margin-top:4px;font-family:'Inter',sans-serif}
    #shopify-section-{{ section.id }} .fh-crosssell-btn{display:inline-block;margin-top:12px;padding:10px 20px;border-radius:6px;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:1.5px;color:#0d1b2a;transition:all .3s;font-family:'Inter',sans-serif}
    #shopify-section-{{ section.id }} .fh-crosssell-card:hover .fh-crosssell-btn{filter:brightness(1.15);transform:translateX(4px)}
    @media(max-width:1024px){
      #shopify-section-{{ section.id }} .fh-crosssell-grid{grid-template-columns:repeat(2,1fr)}
    }
    @media(max-width:900px){
      #shopify-section-{{ section.id }} .fh-crosssell{padding:64px 20px}
      #shopify-section-{{ section.id }} .fh-crosssell-title{font-size:36px}
    }
    @media(max-width:500px){
      #shopify-section-{{ section.id }} .fh-crosssell-grid{grid-template-columns:1fr}
      #shopify-section-{{ section.id }} .fh-crosssell-card{aspect-ratio:4/3}
    }
  </style>
</div>

{% schema %}
{
  "name": "Cross-sell collection",
  "tag": "section",
  "class": "fh-crosssell-section",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Couleur de fond",
      "default": "#f9f7f2"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Couleur accent",
      "default": "#d4a843"
    },
    {
      "type": "text",
      "id": "overline",
      "label": "Surtitre",
      "default": "⚽ Tu supportes aussi"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Titre",
      "default": "Complète ta collection"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Sous-titre",
      "default": "Jerseys édition limitée — Coupe du Monde 2026"
    }
  ],
  "blocks": [
    {
      "type": "product_card",
      "name": "Carte produit",
      "settings": [
        {
          "type": "text",
          "id": "flag_emoji",
          "label": "Emoji drapeau",
          "default": "🇲🇦"
        },
        {
          "type": "text",
          "id": "country",
          "label": "Nom pays",
          "default": "Maroc"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Prix",
          "default": "34,99€"
        },
        {
          "type": "text",
          "id": "gradient",
          "label": "Gradient CSS",
          "default": "linear-gradient(180deg,#c1272d,#5a0f14)"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image produit (optionnel)"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Lien produit"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Cross-sell collection",
      "blocks": [
        { "type": "product_card", "settings": { "flag_emoji": "🇲🇦", "country": "Maroc", "price": "34,99€", "gradient": "linear-gradient(180deg,#c1272d,#5a0f14)" } },
        { "type": "product_card", "settings": { "flag_emoji": "🇩🇿", "country": "Algérie", "price": "34,99€", "gradient": "linear-gradient(180deg,#006233,#002614)" } },
        { "type": "product_card", "settings": { "flag_emoji": "🇨🇮", "country": "Côte d'Ivoire", "price": "34,99€", "gradient": "linear-gradient(180deg,#FF8200,#7a3e00)" } },
        { "type": "product_card", "settings": { "flag_emoji": "🇫🇷", "country": "France", "price": "34,99€", "gradient": "linear-gradient(180deg,#0055A4,#002952)" } }
      ]
    }
  ]
}
{% endschema %}
