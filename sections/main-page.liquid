{% comment %}
  Section: Main Page
  Affiche le contenu des pages statiques (CGV, FAQ, etc.)
{% endcomment %}

<div id="shopify-section-{{ section.id }}">
  <div class="fh-page">
    <div class="fh-page-header">
      <h1 class="fh-page-title">{{ page.title }}</h1>
    </div>
    <div class="fh-page-content rte">
      {{ page.content }}
    </div>
  </div>

  <style>
    #shopify-section-{{ section.id }} .fh-page{max-width:800px;margin:0 auto;padding:64px 48px 100px}
    #shopify-section-{{ section.id }} .fh-page-header{text-align:center;margin-bottom:48px;padding-bottom:32px;border-bottom:2px solid #d4a843}
    #shopify-section-{{ section.id }} .fh-page-title{font-family:'Bebas Neue',Impact,sans-serif;font-size:48px;letter-spacing:2px;text-transform:uppercase;color:#0d1b2a;margin:0}
    #shopify-section-{{ section.id }} .fh-page-content{font-family:'Inter',sans-serif;font-size:15px;line-height:1.8;color:#444;font-weight:300}
    #shopify-section-{{ section.id }} .fh-page-content h2{font-family:'Bebas Neue',Impact,sans-serif;font-size:28px;letter-spacing:1px;color:#0d1b2a;margin:32px 0 16px;text-transform:uppercase}
    #shopify-section-{{ section.id }} .fh-page-content h3{font-family:'Bebas Neue',Impact,sans-serif;font-size:22px;color:#0d1b2a;margin:24px 0 12px}
    #shopify-section-{{ section.id }} .fh-page-content p{margin-bottom:16px}
    #shopify-section-{{ section.id }} .fh-page-content ul,#shopify-section-{{ section.id }} .fh-page-content ol{margin:16px 0;padding-left:24px}
    #shopify-section-{{ section.id }} .fh-page-content li{margin-bottom:8px}
    #shopify-section-{{ section.id }} .fh-page-content a{color:#d4a843;text-decoration:underline;text-underline-offset:3px}
    #shopify-section-{{ section.id }} .fh-page-content a:hover{color:#0d1b2a}
    #shopify-section-{{ section.id }} .fh-page-content strong{color:#0d1b2a;font-weight:600}
    @media(max-width:900px){
      #shopify-section-{{ section.id }} .fh-page{padding:40px 20px 64px}
      #shopify-section-{{ section.id }} .fh-page-title{font-size:36px}
    }
  </style>
</div>

{% schema %}
{
  "name": "Contenu page",
  "tag": "section",
  "class": "fh-main-page-section",
  "settings": []
}
{% endschema %}
